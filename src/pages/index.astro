---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Feed from "../components/Feed.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { PINNED } from "../data/projects";
import { SITE } from "../data/site";
import { getActivity, type RepoActivity } from "../lib/github";
import { buildFeed, mergeActivity, rankProjects } from "../lib/feed";
import Link from "../components/Link.astro";

const activity = await getActivity([...SITE.repos]);
const posts = await getCollection("writing");

// A card can cover more than one repo, so activity is folded per project before
// anything ranks or renders it — keyed by the primary repo, which is what identifies
// the project everywhere below.
const projectActivity: Record<string, RepoActivity> = {};
for (const project of PINNED) {
  const merged = mergeActivity(project.repos, activity);
  if (merged) projectActivity[project.repos[0]] = merged;
}

// Ranked by most-recent push, so the list reorders itself as work moves around.
const order = rankProjects(
  PINNED.map((p) => p.repos[0]),
  projectActivity,
);
const ranked = order
  .map((repo) => PINNED.find((p) => p.repos[0] === repo))
  .filter((p): p is (typeof PINNED)[number] => Boolean(p));

// Eight is enough to show cadence without the page becoming a commit log.
const feed = buildFeed(posts, activity, 8);

const totalCommits = Object.values(activity).reduce(
  (n, r) => n + r.commitCount,
  0,
);
const lastPush = Object.values(activity)
  .map((r) => r.lastCommit)
  .filter((d): d is string => Boolean(d))
  .sort()
  .at(-1);
---

<Base>
  <section class="intro">
    <h1 class="intro__title">{SITE.role}</h1>

    {
      /* Role is interpolated rather than written out, so the heading and this
         sentence can't drift into naming two different things. */
    }
    <div class="intro__body">
      <p>
        I'm a software engineer at {SITE.employer.name}, leading projects end to
        end. The projects below are mine, built in the open. Each one has a note
        on what turned out to be the actual problem.
      </p>
    </div>

    <nav class="intro__links" aria-label="Contact and profiles">
      <Link href={`mailto:${SITE.email}`}>{SITE.email}</Link>
      {
        SITE.profiles.map((p) => (
          <Link href={p.url} rel="me">
            {`${p.label} ${p.handle}`}
          </Link>
        ))
      }
    </nav>
  </section>

  <section class="section">
    <div class="section__head grid">
      <h2 class="label label--ink">Projects</h2>
      <span class="section__aside">Ordered by most recent work</span>
    </div>

    <div class="projects">
      {
        ranked.map((project, i) => (
          <ProjectCard
            project={project}
            activity={projectActivity[project.repos[0]]}
            index={i + 1}
          />
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="section__head grid">
      <h2 class="label label--ink">Activity</h2>
      <span class="section__aside data">
        {totalCommits} commits
        {
          lastPush &&
            ` · updated ${new Date(lastPush).toLocaleDateString("en-US", {
              month: "short",
              day: "numeric",
              timeZone: "UTC",
            })}`
        }
      </span>
    </div>

    <Feed items={feed} />
  </section>
</Base>
