---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const posts = (await getCollection("writing"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => +b.data.date - +a.data.date);
---

<Base
  title="Writing"
  description="Notes from the projects I build, mostly the parts that didn't fit on a project card."
>
  <section class="intro">
    <h1 class="intro__title">Writing</h1>
    <p class="intro__lede">
      Notes from the projects, mostly the parts that didn't fit on a project
      card.
    </p>
  </section>

  <section class="section">
    {
      posts.length === 0 ? (
        <p class="empty">No posts yet.</p>
      ) : (
        <ul class="feed">
          {posts.map((post) => (
            <li class="feed__item grid hangs">
              <time class="feed__date" datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString("en-US", {
                  month: "short",
                  day: "numeric",
                  year: "numeric",
                  timeZone: "UTC",
                })}
              </time>
              <div>
                <h2 class="feed__title">
                  <a href={`/writing/${post.id}/`}>{post.data.title}</a>
                </h2>
                <p class="feed__desc">{post.data.description}</p>
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Base>
