---
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import Link from "../../components/Link.astro";
import { SITE } from "../../data/site";

export const getStaticPaths = (async () => {
  // Drafts get no route at all. Without this filter they'd still build to a real URL —
  // unlinked, but live and in the sitemap. Preview drafts with `astro dev` instead.
  const posts = (await getCollection("writing")).filter((p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);

const readingTime: string | undefined = remarkPluginFrontmatter?.readingTime;

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  });
---

<Base
  title={post.data.title}
  description={post.data.description}
  article={{ published: post.data.date }}
  image={`/og/${post.id}.png`}
  imageAlt={`${post.data.title} — ${SITE.name}`}
>
  <a class="back-link" href="/writing/">← Writing</a>

  {
    /* Same rail as every other page: metadata left, content on the one column body
      text always starts from. */
  }
  <article class="post__head grid">
    <p class="post__meta">
      <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
      {
        readingTime && (
          <>
            <br />
            {readingTime}
          </>
        )
      }
      {
        post.data.draft && (
          <>
            <br />
            Draft
          </>
        )
      }
    </p>

    <div class="post__main">
      <h1 class="post__title">{post.data.title}</h1>

      <div class="prose">
        <Content />
      </div>

      {
        post.data.crosspost && (
          <p class="post__crosspost">
            Also posted at{" "}
            <Link href={post.data.crosspost}>
              {new URL(post.data.crosspost).hostname}
            </Link>
          </p>
        )
      }
    </div>
  </article>
</Base>
