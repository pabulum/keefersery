---
import { getNav } from "../data/nav";
import { SITE } from "../data/site";
import Link from "../components/Link.astro";
// Inter, self-hosted and bundled at build time. The `opsz` cut carries Inter's
// optical-size axis, so display sizes tighten and small sizes open up from one file
// instead of two families. Subsets are unicode-ranged — an English page fetches latin
// only, ~73kB.
import "@fontsource-variable/inter/opsz.css";
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
  /** Set on article pages so the OG type and JSON-LD describe a post, not the site. */
  article?: { published: Date };
  /** Root-relative path to this page's link-preview card. Defaults to the site one. */
  image?: string;
  /** Describes the card for anyone whose reader announces it. */
  imageAlt?: string;
};

const {
  title,
  description,
  article,
  image = "/og.png",
  imageAlt = `${SITE.name} — ${SITE.role}`,
} = Astro.props;

const pageTitle = title
  ? `${title} — ${SITE.name}`
  : `${SITE.name} — ${SITE.role}`;
const metaDescription = description ?? SITE.tagline;
const canonical = new URL(Astro.url.pathname, SITE.url).href;

/*
 * A preview card is three stacked lines — site name, heading, description — and an
 * unfurler draws all three whether or not they say different things. Only the home
 * page has no title of its own, and falling back to the site name there put "Keefer
 * Sery" in the site line and the heading at once, with the role following in the
 * description: one card, the same two facts three times.
 *
 * So the home page's heading is the role, sitting under a site line that already
 * carries the name, and its description drops the role sentence it would otherwise
 * repeat. Every other page passes a real title and is unaffected.
 */
const ogTitle = title ?? SITE.role;
const ogDescription = description ?? (title ? SITE.tagline : SITE.pitch);
// Every scraper that matters resolves og:image against nothing at all — a root-relative
// path is the single most common way a preview silently comes back blank.
const ogImage = new URL(image, SITE.url).href;
const path = Astro.url.pathname;
const nav = await getNav();

// Tells a search engine that these accounts are one person. This is the machine-readable
// half of the verification story; the rel="me" links below are the social half.
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.name,
  url: SITE.url,
  email: `mailto:${SITE.email}`,
  jobTitle: SITE.role,
  description: SITE.tagline,
  worksFor: {
    "@type": "Organization",
    name: SITE.employer.name,
    url: SITE.employer.url,
  },
  sameAs: SITE.profiles.map((p) => p.url),
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name} — writing`}
      href="/rss.xml"
    />

    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />

    {
      /* Built by src/lib/og.ts. The dimensions are stated so a scraper can reserve the
         slot before it has fetched the file — several render the card from the tags
         alone and never come back for the image. */
    }
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {
      article && (
        <>
          <meta
            property="article:published_time"
            content={article.published.toISOString()}
          />
          <meta property="article:author" content={SITE.url} />
        </>
      )
    }

    {
      /* Half of the two-way identity proof — each profile should link back here. */
    }
    {SITE.profiles.map((p) => <link rel="me" href={p.url} />)}

    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {
      /* Applies a stored theme choice before first paint. This has to be inline and
         in <head> — deferred or bundled, it would run after the browser has already
         painted the system-preference colours, and every visit with a non-default
         choice would flash the wrong scheme. No stored choice leaves the attribute
         off entirely, which is what hands control back to prefers-color-scheme. */
    }
    <script is:inline>
      try {
        const t = localStorage.getItem("theme");
        if (t === "light" || t === "dark")
          document.documentElement.dataset.theme = t;
      } catch {}
    </script>

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    {
      /* The page is a printed sheet: a plane of spot colour at the head, and the three
        surface layers appended at the end of it. */
    }
    <div class="sheet">
      <div class="sheet__band"></div>

      <div class="sheet__inner">
        <header class="masthead">
          <a class="masthead__name" href="/">{SITE.name}</a>
          <nav class="masthead__nav label" aria-label="Primary">
            {
              nav.map((item) => (
                <Link
                  href={item.href}
                  aria-current={item.current(path) ? "page" : undefined}
                >
                  {item.label}
                </Link>
              ))
            }
            <button class="theme-toggle" type="button" id="theme-toggle" hidden>
            </button>
          </nav>
        </header>

        <main id="main">
          <slot />
        </main>

        <footer class="colophon grid">
          <p class="label data">© {new Date().getFullYear()}</p>

          <div class="colophon__body">
            <p class="colophon__contact">
              <Link href={`mailto:${SITE.email}`}>{SITE.email}</Link>
              {
                SITE.profiles.map((p) => (
                  <Link href={p.url} rel="me">
                    {p.label}
                  </Link>
                ))
              }
            </p>
            <p>
              Views here are my own and don't represent {SITE.employer.name}.
            </p>
          </div>
        </footer>
      </div>

      {
        /* The sheet's own surface, above its type — ink is printed into a material, so
          the material sits on top of it. The lamp is not here: it lights the desk and
          the sheet as one, so it lives on the page rather than on this element.
          Decorative only, so both stay out of the accessibility tree. */
      }
      <div class="sheet__crumple" aria-hidden="true"></div>
      <div class="sheet__grain" aria-hidden="true"></div>
    </div>

    {
      /* Wires up the theme control: a straight Light/Dark switch, with the system
         preference deciding where it starts.

         Until the visitor actually picks a side, nothing is stored and no attribute is
         set — the page is still being driven by prefers-color-scheme, so a system that
         flips at sunset still flips the site. The matchMedia listener exists only to
         keep the button's own label honest while that is the case.

         The button ships hidden and is revealed here, so it never appears without the
         script that makes it work. */
    }
    <script is:inline>
      (() => {
        const btn = document.getElementById("theme-toggle");
        if (!btn) return;

        const systemDark = window.matchMedia("(prefers-color-scheme: dark)");

        const stored = () => {
          try {
            const t = localStorage.getItem("theme");
            return t === "light" || t === "dark" ? t : null;
          } catch {
            return null;
          }
        };

        // What the visitor is actually looking at, chosen or inherited.
        const effective = () =>
          stored() ?? (systemDark.matches ? "dark" : "light");

        const paint = () => {
          const now = effective();
          btn.textContent = now === "dark" ? "Dark" : "Light";
          // The visible word names the *current* mode, so the accessible name has to
          // spell out the action separately — on its own, "Dark" reads as a promise
          // about what a click will do, which is the opposite of what it means.
          btn.setAttribute(
            "aria-label",
            `Theme: ${now}. Switch to ${now === "dark" ? "light" : "dark"}.`,
          );
        };

        paint();
        btn.hidden = false;

        btn.addEventListener("click", () => {
          const next = effective() === "dark" ? "light" : "dark";
          document.documentElement.dataset.theme = next;
          try {
            localStorage.setItem("theme", next);
          } catch {}
          paint();
        });

        systemDark.addEventListener("change", () => {
          if (!stored()) paint();
        });
      })();
    </script>
  </body>
</html>
