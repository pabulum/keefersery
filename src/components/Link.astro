---
/**
 * Use for any link whose destination comes from data rather than being written as a
 * literal in the template. Applies the off-site rule from ../lib/links: a new tab,
 * plus a warning that a new tab is what's about to happen.
 *
 * The warning is given twice, because one channel does not reach everyone:
 *
 *  - The icon is for anyone who can see the page. It carries aria-hidden, so it is
 *    not announced on top of the text below.
 *  - The text is for assistive tech. It sits inside the anchor rather than in an
 *    aria-describedby so it joins the link's accessible name — descriptions are
 *    announced at the screen reader's discretion, names always are.
 *
 * WCAG 3.2.5 permits opening a new window when the user is warned in advance
 * (techniques G201 and H83); it is the silent version that fails.
 *
 * One sharp edge: the slot drops whitespace-only text between two adjacent
 * expressions, so `{a} {b}` as children arrives as `ab`. Pass a single expression —
 * {`${a} ${b}`} — when the space matters.
 */
import { isExternal, linkAttrs } from "../lib/links";

type Props = {
  href: string;
  /** Extra rel token to preserve, e.g. "me" on the identity links. */
  rel?: string;
  class?: string;
  [key: string]: unknown;
};

const { href, rel, ...rest } = Astro.props;
const external = isExternal(href);
---

<a {...linkAttrs(href, rel)} {...rest}
  ><slot />{
    external && (
      <>
        <span class="visually-hidden"> (opens in new tab)</span>
        <svg
          class="external-icon"
          aria-hidden="true"
          focusable="false"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M6.75 3.5H3.5v9h9V9.25" />
          <path d="M9.75 3h3.25v3.25M13 3 7.75 8.25" />
        </svg>
      </>
    )
  }</a
>
