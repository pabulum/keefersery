---
import type { FeedItem } from "../lib/feed";
import Link from "./Link.astro";

type Props = {
  items: FeedItem[];
  /** Commits shown per day-bundle before collapsing to a "+N more" line. */
  commitsPerItem?: number;
};

const { items, commitsPerItem = 4 } = Astro.props;

const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    timeZone: "UTC",
  });

const fmtFull = (d: Date) =>
  d.toLocaleDateString("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  });
---

{
  items.length === 0 ? (
    <p class="empty">Nothing here yet.</p>
  ) : (
    <ul class="feed">
      {items.map((item) => (
        <li class="feed__item grid hangs">
          <time
            class="feed__date"
            datetime={item.date.toISOString()}
            title={fmtFull(item.date)}
          >
            {fmtDate(item.date)}
          </time>

          <div>
            {item.kind === "post" ? (
              <>
                {/* The kind sits on its own line above the title rather than inside
                    it, so the heading's accessible name is just the title. */}
                <span class="label feed__kind">Wrote</span>
                <h3 class="feed__title">
                  <Link href={item.href}>{item.title}</Link>
                </h3>
                <p class="feed__desc">{item.description}</p>
              </>
            ) : (
              <>
                <span class="label feed__kind">
                  Shipped · {item.commits.length} commit
                  {item.commits.length === 1 ? "" : "s"}
                </span>
                <h3 class="feed__title">
                  <Link href={`https://github.com/${item.repo}`}>
                    {item.repoName}
                  </Link>
                </h3>
                <ul class="feed__commits">
                  {item.commits.slice(0, commitsPerItem).map((c) => (
                    <li>
                      <Link class="feed__sha" href={c.url}>
                        {c.shortSha}
                      </Link>
                      <span>{c.title}</span>
                    </li>
                  ))}
                  {item.commits.length > commitsPerItem && (
                    <li class="feed__more">
                      + {item.commits.length - commitsPerItem} more
                    </li>
                  )}
                </ul>
              </>
            )}
          </div>
        </li>
      ))}
    </ul>
  )
}
