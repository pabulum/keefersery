---
import type { Project } from "../data/projects";
import type { RepoActivity } from "../lib/github";
import Sparkline from "./Sparkline.astro";
import Link from "./Link.astro";

type Props = {
  project: Project;
  activity?: RepoActivity;
  /** 1-based position in the ranked list, set in the rail as 01, 02, … */
  index: number;
};

const { project, activity, index } = Astro.props;

const repoUrls = project.repos.map(
  (repo) => `https://github.com/${repo}` as const,
);

/**
 * Where the heading points. A deployed instance wins when there is one — it is the
 * thing a reader can actually try — and the primary repo stands in when there is not,
 * rather than leaving the only title on the page unclickable.
 */
const primaryUrl = project.liveUrl ?? repoUrls[0]!;

/**
 * The insight strings carry *emphasis* markers, but they're plain TS strings and never
 * see a markdown pass. Rather than pull a parser in for one inline construct, split on
 * the delimiter — odd-indexed segments are the emphasized ones.
 */
const emphasized = (text: string) =>
  text.split("*").map((segment, i) => ({ text: segment, em: i % 2 === 1 }));

const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString("en-US", {
    month: "short",
    year: "numeric",
    timeZone: "UTC",
  });

const relative = (iso: string) => {
  const days = Math.floor((Date.now() - +new Date(iso)) / 86_400_000);
  if (days <= 0) return "today";
  if (days === 1) return "yesterday";
  if (days < 30) return `${days}d ago`;
  const months = Math.floor(days / 30);
  return months < 12 ? `${months}mo ago` : `${Math.floor(months / 12)}y ago`;
};
---

<article class="project grid hangs">
  {
    /* The rail. Aria-hidden because the number is a position on the grid, not a fact
      about the project — the list order already carries it for a screen reader. */
  }
  <p class="project__index" aria-hidden="true">
    {String(index).padStart(2, "0")}
  </p>

  <div>
    <h3 class="project__name">
      <Link href={primaryUrl}>{project.name}</Link>
    </h3>

    <p class="project__tagline">{project.tagline}</p>

    {
      activity?.lastCommit && (
        <div class="meta" style="margin-top: var(--space-s)">
          <Sparkline data={activity.weeklyHistogram} label={project.name} />
          <span>{activity.commitCount} commits</span>
          <span>Last push {relative(activity.lastCommit)}</span>
        </div>
      )
    }

    <p class="project__insight">
      {
        emphasized(project.insight).map((part) =>
          part.em ? <em>{part.text}</em> : part.text,
        )
      }
    </p>

    <ul class="project__stack label">
      {project.stack.map((tech) => <li>{tech}</li>)}
    </ul>

    <div class="project__foot">
      {
        /* No literal arrow — Link already appends the new-tab indicator, and two
          glyphs saying "this goes somewhere" is one too many. */
      }
      {project.liveUrl && <Link href={project.liveUrl}>Open the app</Link>}
      {
        /* One repo gets the generic word; several get their own names, because "Source"
          twice over says nothing about which half a reader is opening. */
        repoUrls.length === 1 ? (
          <Link href={repoUrls[0]!}>Source</Link>
        ) : (
          repoUrls.map((url, i) => (
            <Link href={url}>{project.repos[i]!.split("/")[1]}</Link>
          ))
        )
      }
      {
        activity?.firstCommit && activity.lastCommit && (
          <span class="section__aside data">
            {fmt(activity.firstCommit)} – {fmt(activity.lastCommit)}
          </span>
        )
      }
    </div>
  </div>
</article>
