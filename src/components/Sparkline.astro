---
/**
 * 26-week commit histogram as bars. Deliberately unlabelled — it's a texture cue for
 * "steady vs. abandoned," not a chart anyone should read values off. The accessible
 * name carries the actual numbers for anyone who can't see it.
 */

type Props = {
  data: number[];
  label: string;
};

const { data, label } = Astro.props;

// Whole-pixel bar and gap, square corners. The bars are printer's marks, not a chart
// widget — nothing here should be rounded or antialiased into a smear.
const BAR = 3;
const GAP = 2;
const HEIGHT = 16;
const max = Math.max(1, ...data);
const width = data.length * (BAR + GAP) - GAP;
// One extra pixel below the bars carries the baseline rule.
const TOTAL_H = HEIGHT + 1;

// "Hot" = the trailing quarter, so recent work is visually distinct from history.
const hotFrom = data.length - 13;
const total = data.reduce((a, b) => a + b, 0);
---

<svg
  class="sparkline"
  width={width}
  height={TOTAL_H}
  viewBox={`0 0 ${width} ${TOTAL_H}`}
  role="img"
  aria-label={`${label}: ${total} commits over the last ${data.length} weeks`}
>
  {
    /*
    The bars sit on a rule rather than floating. The previous version floored every
    zero-week at a 1px tick so the run wouldn't break — but on a repo with a long
    quiet stretch that produced a row of evenly spaced dots that read as a dashed
    border, not as data. The baseline carries continuity now, so a zero week can be
    what it actually is: nothing above the line.
  */
  }
  <rect class="sparkline__base" x="0" y={HEIGHT} width={width} height="1"
  ></rect>

  {
    data.map((value, i) =>
      value === 0 ? null : (
        <rect
          x={i * (BAR + GAP)}
          y={HEIGHT - Math.max(2, Math.round((value / max) * HEIGHT))}
          width={BAR}
          height={Math.max(2, Math.round((value / max) * HEIGHT))}
          data-hot={i >= hotFrom ? "true" : "false"}
        />
      ),
    )
  }
</svg>
