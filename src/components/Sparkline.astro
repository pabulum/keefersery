---
/**
 * 26-week commit histogram as bars. Deliberately unlabelled — it's a texture cue for
 * "steady vs. abandoned," not a chart anyone should read values off. The accessible
 * name carries the actual numbers for anyone who can't see it.
 */

type Props = {
  data: number[];
  label: string;
};

const { data, label } = Astro.props;

const BAR = 3;
const GAP = 1.5;
const HEIGHT = 18;
const max = Math.max(1, ...data);
const width = data.length * (BAR + GAP) - GAP;

// "Hot" = the trailing quarter, so recent work is visually distinct from history.
const hotFrom = data.length - 13;
const total = data.reduce((a, b) => a + b, 0);
---

<svg
  class="sparkline"
  width={width}
  height={HEIGHT}
  viewBox={`0 0 ${width} ${HEIGHT}`}
  role="img"
  aria-label={`${label}: ${total} commits over the last ${data.length} weeks`}
>
  {
    data.map((value, i) => {
      // Floor at 1px so a zero-week still reads as a tick rather than a gap.
      const h =
        value === 0 ? 1 : Math.max(2, Math.round((value / max) * HEIGHT));
      return (
        <rect
          x={i * (BAR + GAP)}
          y={HEIGHT - h}
          width={BAR}
          height={h}
          rx={1}
          data-hot={i >= hotFrom && value > 0 ? "true" : "false"}
          opacity={value === 0 ? 0.35 : 1}
        />
      );
    })
  }
</svg>
